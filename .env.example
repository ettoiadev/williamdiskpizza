# Supabase Configuration
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# O arquivo ".env" NAO deve ser versionado (ja esta no .gitignore).
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Admin Configuration
VITE_ADMIN_EMAIL=admin@exemplo.com
